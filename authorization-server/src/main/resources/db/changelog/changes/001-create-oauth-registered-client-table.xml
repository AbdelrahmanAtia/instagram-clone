<?xml version="1.0" encoding="UTF-8"?>

<databaseChangeLog
    xmlns="http://www.liquibase.org/xml/ns/dbchangelog"
    xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
    xsi:schemaLocation="
        http://www.liquibase.org/xml/ns/dbchangelog
        http://www.liquibase.org/xml/ns/dbchangelog/dbchangelog-latest.xsd">

    <changeSet id="001-create-oauth2-registered-client-table" author="abdelrahman_attya">

        <createTable tableName="oauth2_registered_client">

            <column name="id" type="UUID">
                <constraints primaryKey="true" primaryKeyName="pk_oauth2_registered_client" nullable="false"/>
            </column>

            <column name="version" type="INT">
                <constraints nullable="false"/>
            </column>

            <column name="client_id" type="VARCHAR(255)">
                <constraints nullable="false" unique="true" uniqueConstraintName="uk_oauth2_registered_client_client_id"/>
            </column>

            <column name="client_secret" type="VARCHAR(500)">
                <constraints nullable="true"/>
            </column>

        </createTable>

    </changeSet>

</databaseChangeLog>